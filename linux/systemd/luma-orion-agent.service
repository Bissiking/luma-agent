[Unit]
Description=LUMA Orion Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luma-agent
Group=luma-agent
WorkingDirectory=/opt/luma-agent
Environment=PYTHONUNBUFFERED=1
Environment=ORION_SERVICE_MODE=systemd
ExecStart=/opt/luma-agent/venv/bin/python /opt/luma-agent/agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
